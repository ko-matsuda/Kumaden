<UXML xmlns="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement class="root">

    <!-- Tab Bar -->
    <ui:VisualElement class="tab-bar">
      <ui:Button name="chatTab" text="Chat" class="tab-button" />
      <ui:Button name="sessionsTab" text="Sessions" class="tab-button" />
      <ui:Button name="settingsTab" text="Settings" class="tab-button" />
      <ui:Button name="errorsTab" text="Errors" class="tab-button" />
      <ui:Button name="imageTab" text="Image" class="tab-button" />
    </ui:VisualElement>

    <!-- Main Content Area -->
    <ui:VisualElement class="tab-wrapper">

      <!-- Chat Tab -->
      <ui:VisualElement name="chatContainer" class="tab-container">
        <ui:ScrollView name="chatContent" class="chat-content" />
        <ui:VisualElement class="input-bar">
          <ui:TextField name="inputField" />
          <ui:Button name="sendButton" text="Send" />
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- Sessions Tab -->
      <ui:VisualElement name="sessionsContainer" class="tab-container">
        <ui:Label text="Sessions" class="sidebar-header" />
        <ui:ScrollView name="sessionList" class="session-list" />
        <ui:Button name="newSessionBtn" text="New Chat" class="new-chat-button" />
        <ui:VisualElement class="sessions-control-wrapper">
          <ui:TextField name="sessionNameField" label="Session Name:" />
          <ui:Button name="saveSessionBtn" text="Save Session" />
          <ui:Button name="loadSessionBtn" text="Load Session" />
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- Settings Tab -->
      <ui:VisualElement name="settingsContainer" class="tab-container">
        <ui:ScrollView name="settingsScrollView" class="settings-scroll">
          <!-- Everything injected in C# will go here -->
        </ui:ScrollView>
      </ui:VisualElement>

      <!-- Errors Tab -->
      <ui:VisualElement name="errorsContainer" class="tab-container">
        <ui:Label text="Error Logs" class="sidebar-header" />
        <ui:ScrollView name="errorList" class="chat-content" />
        <ui:Button name="sendErrorToAIButton" text="Send to AI" class="send-button" />
      </ui:VisualElement>

      <ui:VisualElement name="imageContainer" class="tab-container">
        <ui:TextField name="imagePromptField" label="Image Prompt:" />
        <ui:Button name="generateImageButton" text="Generate Image" />
        <ui:ScrollView name="generatedImagesContainer" class="image-results-container" />
      </ui:VisualElement>

    </ui:VisualElement>

  </ui:VisualElement>
</UXML>
